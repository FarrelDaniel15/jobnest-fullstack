{
  "name": "jobnest-fullstack",
  "version": "1.0.0",
  "description": "JobNest Full-Stack Monolithic REST API + React SPA",
  "main": "api/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon src/app.js",
    "start": "node api/index.js",
    "build": "npm run build:client && npx prisma generate",
    "build:client": "cd client && npm install && npm run build",
    "prisma:generate": "npx prisma generate",
    "prisma:push": "npx prisma db push",
    "prisma:seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "prisma": "^5.10.0"
  }
}