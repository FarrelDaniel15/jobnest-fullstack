datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           Int           @id @default(autoincrement())
  name         String
  email        String        @unique
  password     String
  role         String        @default("candidate") // "candidate" | "employer"
  createdAt    DateTime      @default(now())
  companies    Company[]
  applications Application[]

  @@map("users")
}

model Company {
  id          Int      @id @default(autoincrement())
  userId      Int
  name        String
  description String?
  location    String
  website     String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs        Job[]

  @@map("companies")
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String   @unique
  jobs      Job[]

  @@map("categories")
}

model Job {
  id           Int           @id @default(autoincrement())
  companyId    Int
  categoryId   Int
  title        String
  description  String
  salary       Int?
  jobType      String        // "FULL_TIME", "PART_TIME", "REMOTE", "INTERNSHIP"
  location     String
  createdAt    DateTime      @default(now())
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  applications Application[]

  @@map("jobs")
}

model Application {
  id        Int      @id @default(autoincrement())
  jobId     Int
  userId    Int
  resumeUrl String
  notes     String?
  status    String   @default("PENDING") // "PENDING", "REVIEWED", "ACCEPTED", "REJECTED"
  appliedAt DateTime @default(now())
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("applications")
}